    "properties": {
      "draft_id": {
        "title": "Draft Id",
        "type": "string"
      },
      "name": {
        "title": "Name",
        "type": "string"
      },
      "snapshot": {
        "additionalProperties": true,
        "description": "Lossless editor authoring state. Backend is authoritative; preserve unknown nested fields. Source bytes are copied into encrypted draft storage (10 MB source limit); metadata limit is 5 MB. No local filesystem paths or executable code.",
        "properties": {
          "configuration": {
            "type": "object"
          },
          "family": {
            "enum": [
              "mmm",
              "var"
            ],
            "type": "string"
          },
          "model_details": {
            "type": "object"
          },
          "model_setup": {
            "type": "object"
          },
          "schema_version": {
            "enum": [
              1
            ],
            "type": "integer"
          },
          "source": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "properties": {
                  "content_base64": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "origin": {
                    "description": "Optional uploaded dataset lineage. Backend verifies ownership and exact bytes, then supplies sha256. Retain the returned origin when reopening; it never replaces frozen source bytes.",
                    "properties": {
                      "kind": {
                        "enum": [
                          "uploaded_file"
                        ],
                        "type": "string"
                      },
                      "id": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "sha256": {
                        "pattern": "^[a-f0-9]{64}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "name",
                  "content_base64"
                ],
                "type": "object"
              }
            ]
          },
          "transformations": {
            "type": "object"
          }
        },
        "required": [
          "schema_version",
          "family",
          "configuration",
          "model_setup",
          "model_details",
          "transformations"
        ],
        "title": "Snapshot",
        "type": "object"
      },
      "study_id": {
        "title": "Study Id",
        "type": "string"
      }
    },
    "required": [
      "study_id",
      "draft_id",
      "name",
      "snapshot"
    ],
    "title": "create_recipe_draftArguments",
    "type": "object"
